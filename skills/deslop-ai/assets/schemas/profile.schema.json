{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deslop-profile-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "genre", "inputs"],
  "properties": {
    "schemaVersion": {"const": "deslop-profile-request/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "genre": {"enum": ["consulting", "academic"]},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1}},
    "approvedExcerptIds": {"type": "array", "items": {"type": "string"}}
  }
}
